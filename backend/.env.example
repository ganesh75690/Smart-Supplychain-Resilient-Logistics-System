# ============================================
# Smart Supply Chain Platform - Environment Variables
# ============================================

# Database Configuration
POSTGRES_URL=postgresql://postgres:password@localhost:5432/supply_chain_db
MONGODB_URL=mongodb://localhost:27017/supply_chain_realtime

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Services (Mock - No real credentials needed for demo)
GOOGLE_VERTEX_AI_API_KEY=mock-vertex-ai-key
GOOGLE_GEMINI_API_KEY=mock-gemini-key
GOOGLE_MAPS_API_KEY=mock-maps-key
FIREBASE_API_KEY=mock-firebase-key
BIGQUERY_API_KEY=mock-bigquery-key

# Firebase Real Demo Configuration
FIREBASE_PROJECT_ID=supply-chain-demo-5d7cd
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase_service_account.json
FIREBASE_DATABASE_URL=https://supply-chain-demo-5d7cd-default-rtdb.firebaseio.com
FIREBASE_WEB_API_KEY=AIzaSyDemoKeyForWebClient

# App Configuration
APP_NAME=Smart Supply Chain Platform
APP_VERSION=1.0.0
DEBUG=True
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=app.log
SECURITY_LOG_FILE=security.log
API_LOG_FILE=api_requests.log

# Rate Limiting Configuration
DEFAULT_RATE_LIMIT_PER_MINUTE=60
DEFAULT_RATE_LIMIT_PER_HOUR=1000
DEFAULT_RATE_LIMIT_PER_DAY=10000

# Auth Rate Limiting (Stricter)
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_PER_HOUR=100
AUTH_RATE_LIMIT_PER_DAY=500

# AI Services Rate Limiting
AI_RATE_LIMIT_PER_MINUTE=30
AI_RATE_LIMIT_PER_HOUR=500
AI_RATE_LIMIT_PER_DAY=5000

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000

# Cache Configuration
CACHE_TTL_DEFAULT=3600
CACHE_TTL_SHORT=300
CACHE_TTL_LONG=86400

# Monitoring & Health Checks
HEALTH_CHECK_INTERVAL=30
METRICS_ENABLED=True

# Production Settings (Set to False for production)
DEBUG=False
TESTING=False

# Security Settings
ALLOWED_HOSTS=["localhost", "127.0.0.1", "0.0.0.0"]
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# External API Keys (Optional - for real implementations)
EXTERNAL_API_KEY=your-external-api-key
WEBHOOK_SECRET=your-webhook-secret

# Development Settings
RELOAD=True
WORKERS=1

# Production Settings
# RELOAD=False
# WORKERS=4
